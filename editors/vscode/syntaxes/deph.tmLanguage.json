{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "deph",
  "scopeName": "source.deph",
  "patterns": [
    { "include": "#generated-marker" },
    { "include": "#comment" },
    { "include": "#policy-block" },
    { "include": "#waive" },
    { "include": "#project-block" },
    { "include": "#string" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.deph",
      "match": "//.*$"
    },
    "generated-marker": {
      "name": "comment.block.documentation.deph",
      "match": "^// ---- generated by deph scan.*$"
    },
    "string": {
      "name": "string.quoted.double.deph",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.deph", "match": "\\\\[\"\\\\]" }
      ]
    },
    "policy-block": {
      "begin": "\\b(policy)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.policy.deph" },
        "2": { "name": "punctuation.section.block.begin.deph" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.block.end.deph" } },
      "patterns": [
        { "include": "#comment" },
        {
          "match": "\\b(fail|warn)\\b",
          "name": "keyword.control.action.deph"
        },
        {
          "match": "\\b(vuln|lag|license)\\b",
          "name": "support.type.subject.deph"
        },
        {
          "match": "\\b(not|in)\\b",
          "name": "keyword.operator.word.deph"
        },
        {
          "match": ">=|<=|==|!=|>|<",
          "name": "keyword.operator.comparison.deph"
        },
        {
          "match": "\\b(critical|high|medium|moderate|low|major|minor|patch)\\b",
          "name": "constant.language.severity.deph"
        },
        { "include": "#list" }
      ]
    },
    "list": {
      "begin": "\\[",
      "end": "\\]",
      "name": "meta.list.deph",
      "patterns": [
        { "match": "[^,\\]\\s]+", "name": "string.unquoted.value.deph" }
      ]
    },
    "waive": {
      "begin": "\\b(waive)\\s+(\\S+)",
      "beginCaptures": {
        "1": { "name": "keyword.control.waive.deph" },
        "2": { "name": "constant.other.advisory-id.deph" }
      },
      "end": "$",
      "patterns": [{ "include": "#string" }, { "include": "#comment" }]
    },
    "project-block": {
      "begin": "\\b(project)\\s+(\"[^\"]*\")",
      "beginCaptures": {
        "1": { "name": "storage.type.project.deph" },
        "2": { "name": "entity.name.section.project.deph" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.block.end.deph" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        {
          "match": "\\b(ecosystem|manifest)(=)",
          "captures": {
            "1": { "name": "variable.parameter.attribute.deph" },
            "2": { "name": "keyword.operator.assignment.deph" }
          }
        },
        { "include": "#dep-line" }
      ]
    },
    "dep-line": {
      "begin": "\\b(dep)\\s+(\\S+)\\s+(\\S+)",
      "beginCaptures": {
        "1": { "name": "storage.type.dep.deph" },
        "2": { "name": "entity.name.function.package.deph" },
        "3": { "name": "constant.numeric.version.deph" }
      },
      "end": "$",
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        {
          "match": "(->)\\s*(\\S+)",
          "captures": {
            "1": { "name": "keyword.operator.arrow.deph" },
            "2": { "name": "constant.numeric.version.latest.deph" }
          }
        },
        {
          "match": "\\btransitive\\b",
          "name": "storage.modifier.transitive.deph"
        },
        {
          "match": "\\b(license)(=)([^\\s\\]]+)",
          "captures": {
            "1": { "name": "variable.parameter.attribute.deph" },
            "2": { "name": "keyword.operator.assignment.deph" },
            "3": { "name": "string.unquoted.license.deph" }
          }
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "name": "meta.tags.deph",
          "patterns": [
            {
              "match": "(vuln)(:)(critical|high|medium|moderate|low|\\w+)(:)([^,\\]\\s]+)",
              "captures": {
                "1": { "name": "support.type.tag.deph" },
                "3": { "name": "constant.language.severity.deph" },
                "5": { "name": "constant.other.advisory-id.deph" }
              }
            },
            {
              "match": "(lag)(:)(major|minor|patch)",
              "captures": {
                "1": { "name": "support.type.tag.deph" },
                "3": { "name": "constant.language.severity.deph" }
              }
            },
            { "match": "[^,\\]\\s]+", "name": "meta.tag.unknown.deph" }
          ]
        }
      ]
    }
  }
}
